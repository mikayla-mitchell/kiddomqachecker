[auth]
# This must exactly match the final deployed URL plus /oauth2callback.
redirect_uri = "https://your-app.streamlit.app/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "replace-with-google-oauth-client-id.apps.googleusercontent.com"
client_secret = "replace-with-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[access]
allowed_email_domains = ["kiddom.co"]
admin_emails = ["app-owner@kiddom.co"]
jira_reviewer_mode = "self"

[jira]
base_url = "https://kiddom.atlassian.net"
user_email = "jira-service-account@example.com"
api_token = "replace-with-an-atlassian-api-token"
project_key = "PMIM"
ready_for_qa_status = "Ready for QA"
qa_account_id = "replace-with-the-qa-owner-account-id"
max_results = 50

# Optional: replace the default assigned/open-ticket query. The placeholders
# {account_id} and {project_key} are filled by the app.
# ticket_jql = 'project = "{project_key}" AND assignee = "{account_id}" AND statusCategory != Done ORDER BY updated DESC'

# Optional. Add an entry only if Jira user search cannot uniquely match a
# signed-in Google email. Values are Jira Cloud account IDs, not usernames.
[jira_user_map]
# "reviewer@kiddom.co" = "712020:example-jira-account-id"
